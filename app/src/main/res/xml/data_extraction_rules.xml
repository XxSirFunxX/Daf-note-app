<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="chaharkhat_score.db"/>
        <include domain="database" path="chaharkhat_score.db-wal"/>
        <include domain="database" path="chaharkhat_score.db-shm"/>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="custom_symbols/"/>
        <exclude domain="file" path="exports/"/>
        <exclude domain="root" path="cache/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="chaharkhat_score.db"/>
        <include domain="database" path="chaharkhat_score.db-wal"/>
        <include domain="database" path="chaharkhat_score.db-shm"/>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="custom_symbols/"/>
        <exclude domain="file" path="exports/"/>
        <exclude domain="root" path="cache/"/>
    </device-transfer>
</data-extraction-rules>
